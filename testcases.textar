== serialize.MultilineWithEmptyLineUnindented
MultilineString: '''
Line 1

Line 3
'''

== tojson.SimpleTabIndentedMultilineString
# Multiline strings can be indented.
# The indentation is not part of the interpreted string.
# The closing quote's indentation determines the indent.
MultilineString: '''
	Hello
	World
	'''

== tojson.MultilineStringWithInnerTabIndentation
# Don't eat all leading whitespace.
CodeString: '''
	package main
	func main() {
		return
	}
	'''

== tojson.SimpleNonTabIndentedMultilineString
# Support space indentation too.
MultilineString: '''
                Hello
                World
                '''

== tojson.TabIndentedEmptyLines
# Empty lines don't need to be indented.
MultilineString: '''
	1
	2

	
	3
	'''

== tojson.BadIndentation
# Error out on inconsistent indentation.
# Do you report line numbers?
# Then make sure the line number is accurate.
GoodString: '''
  1
  2
  3
  '''

BadString: '''
    1
  2
    3
    '''

== tojson.MultilineTabsAndSpaces
# Allow both tabs and spaces.
Object: {
	MultilineString: '''
	                This is a
	                multiline
	                string!
	                '''
}

== tojson.RawTabsAndSpaces
# Don't remove indentation from raw strings though.
Object: {
	RawString: '''|
	          This is a
	          raw
	          string!
	          '''
}

== tojson.MultiEmptyLines
Object: {
  EmptyString: '''


    '''
}

