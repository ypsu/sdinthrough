Date:  {
Day:{Year:   1999    Month: 12   Day:	30}

Time:{Hour: 13 Minute: 34}

Empty1: {  }
Empty2: {
}
Empty3: {  }}

== fmt.ObjectNewlines
AList: [
  { k1: v1
  k2: v2 }{k1: v1
  k2: [v2]}
]

== fmt.MultiBlockIndentation
# The indentation level is determined by the number of open blocks.

List1: [
x
[
1
]
y
]

== fmt.SaveIndentSimple
# Save the extra indent for the inner block if:
# - the last child starts on the same line as the current node,
# - there's no newline or comment after the child's closing token.
Key1: [[
]]
Key2: [[
  Value
]]
Key3: [{
  InnerKey: InnerValue
}]

== fmt.SaveIndentDeep
# Save the extra indent for the inner block if:
# - the last child starts on the same line as the current node,
# - there's no newline or comment after the child's closing token.
Key: [Value1 Value2 [
  Value3 Value4 [[[
    Value5
]]]]]

== fmt.Indent1
Key: [
  [
    Value1
  ]
  [
    Value2
  ]
]

== fmt.Indent2
Key: [[
    Value1
  ][
    Value2
]]

== fmt.Indent3
Key: [{
    Key1: Value1
  }{
    Key2: Value2
}]

== fmt.Indent4
Key: [[
    Value2
  ]
]

== fmt.Indent5
Key: [[
  SomeListValue ] {
  InnerKey: InnerValue
  }]

== fmt.MoarIndents
List1: [1 2
3 4]
List2: [[1 2
3 4]]
List3: [[1 2] [3 4
5 6]]
List4: [1 2
[3 4 5 6]]
List5: [[1 2]
[3 4 5 6]]
List6: [[
1 2]
[3 4 5 6]]

== fmt.CloseTokens
# } must be on its own line in multiline objects.
# No such rule for ].
A: [
  v1]
B: {
  k2:v2}
C: [{
  k3: v3}]
D: { k4: [v4
]}

