== tokenize.SpecialSymbols
# Backslash-quote other special symbols in the quoted Fragment field.
# Tab: 	
# Double quote: "
# Backslash: \
# Test: \\"	\
== tokenize.BareTokensAroundComment
Token1
# Some comment.
Token2
== tokenize.SideComment
BareToken  # Comment can start anywhere.
# Not just at the beginning of the line.
== tokenize.BareNumbers
# Bare tokens can contain digits too.
BareToken1 12

== tokenize.Symbols
# Bare tokens can contain symbols too.
# Tokenizer doesn't try to make sense of them, accepts anything.
# (We'll introduce a few specially handled symbols later.)
Floating_Number -12.34e5
_Bare,Token|1-2+3/5@6\n -12..34e5@abc_!\

== tokenize.KeyValue1
# The colon is the first special symbol.
# It ends a bare token; i.e. emit the token after you've seen it.
# These are called name tokens.
Key:  Value
Key2: Value2
== tokenize.KeyValue2
# The colon is a special symbol.
# It ends a bare token; i.e. emit the token after you've seen it.
# These are called name tokens.
Key:Value
Key2:Value2
== tokenize.KeyValue3
# The colon is a special symbol.
# It ends a bare token; i.e. emit the token after you've seen it.
# These are called name tokens.
_:Value
== tokenize.ConsecutiveNameTokens
# This is invalid sdin but only the AST parser will recognize this.
a: b:c:
