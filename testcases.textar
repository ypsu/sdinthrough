== forms.ImportSections
stdemo.GoImport(
  _:            'example.com/groupserver/initserver'
  userpb:       'example.com/groupmanager/user_generated_proto'
  membershippb: 'example.com/groupmanager/membership_generated_proto'
  lookuppb:     'example.com/groupserver/lookup_generated_proto'
  grouppb:      'example.com/groupmanager/group_generated_proto'

  'os'
  'strings'
  'bytes'

  _: 'embed'
)

== forms.ImportRemoveComments
# The import section in Go is usually autogenerated so remove any human commentary.
# The _ imports are manual so keep the Post comments for those.
stdemo.GoImport(
  # Remove all Pre commentary.
  userpb:       'example.com/groupmanager/user_generated_proto'
  membershippb: 'example.com/groupmanager/membership_generated_proto'
  lookuppb:     'example.com/groupserver/lookup_generated_proto'
  grouppb:      'example.com/groupmanager/group_generated_proto'
  _:            'embed'

  _: 'example.com/groupserver/initserver'  # For the autostart.

  # Remove all Pre commentary.
  'os'   # Remove this post comment.
  'fmt'
)

== forms.ImportUnnamedAndBlank
stdemo.GoImport(
  _:'embed' 'fmt'
)

