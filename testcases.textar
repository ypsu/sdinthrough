Date2: [ [Year   1999    Month 12   Day	30] [Hour 13 Minute  34]]

== fmt.MultilineBlock
# Recap: non-singleline objects: one field-value pair on each line.
# Lists: keep them as they were in the input.

ExampleDate1: {Year:   1999

Month:12   

		Day:	30} ExampleDate2:  [Year   1999    Month 12
Day	30]

