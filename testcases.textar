# In a multiline string each line ends with a newline, unix-style.
MultilineString: '''
Hello
world!
'''

== serialize.EmptyMultiline
EmptyString: '''
'''

== serialize.MultilineWithTags
# The line with the opening quotes can have a tag after the quotes.
# The tag can contain any characters except | and a newline.
