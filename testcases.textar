package main
func main() {
	return
}
'''

== tojson.InvalidMultiquoteString
# There are no other forms of multiquote strings.
String: ''' '''

== tojson.InvalidTag1
String: '''invalid'''

== tojson.InvalidTag2
String: '''invalid\n'''

== tojson.InvalidQuote
# Only triple single quotes work.
