S: '''
  Hello
  ''''

== serialize.MultiquoteStrings1
# Interpret the strings when serializing so that the output stays on a single line.
A: '''|raw string line 1
  line 2'''
# Remove extra indentation for multiline strings.
# The closing quote's line defines the indentation to remove.
B: '''
  multiline
  string
  '''

== serialize.MultiquoteStrings2
# Interpret the strings when serializing so that the output stays on a single line.
A: '''some tag 1|raw string line 1
  line 2'''
# Remove extra indentation for multiline strings.
# The closing quote's line defines the indentation to remove.
B: '''tag 2
  multiline
  string
  '''

