AField1: Value1
AField22: Value22
AField333: Value333

BField22: 22
BField1:      Value1
BField333: "Value333"

CField333: 'Value333'
CField22: 2.2
CField1: "Value1"

DShort: 1
DAVeryLongFieldName: 2

== fmt.FlatAlignment
AField22: Value22
AField1.FlatField: Value1

BField1a: Value1
BField55555+:  Value55555
BField1b: Value1

CField7777777+:  Value7777777
  CField7777777+:    Value7777777
CField333: Value333
CField1.FlatObjectList+:     Value1
  CField22.FlatValue: Value22
    CField22.Subobject.AnotherFlatObject:   Value22
CField55555: Value55555

== fmt.CommentAlignment
AField1: Value1 # comment
AField22: Value22    # comment
AField333: Value333    # comment

BField22: 22    # comment
BField1:      Value1    # comment
BField333: "Value333"    # comment

CField333: 'Value333'    # comment
CField22: 2.2 # comment
CField1: "Value1"	# comment

DShort: 1 # comment
DAVeryLongFieldName: 2# comment

== fmt.AlignmentBlocks
AField1: Value1 # comment
AField22: Value22    # comment
AField333: Value333    # comment
# Full-line comments end the alignment block.
BField22: 22    # comment
BField1:      Value1
BField333: "Value333"    # comment
List: [ # lists like this
] # end the alignment block
CField4444: 'Value4444'    # comment
CField22: 2.2 # comment
CField1: "Value1"	# comment
Object: { # objects like this
} # end the alignment block
DShort: 1 # comment
DAVeryLongFieldName: 2# comment

== fmt.SingleLineBlocks
# Single line lists and objects don't end the alignment block.

AField1: Value1 # comment
EmptyList: [] # block
AField22: Value22    # comment
EmptyBlock: {} # block
AField333: Value333    # comment
List: [1 2 3] # block
BField22: 22    # comment
Object: { A:1 B:2 C:3} # block
BField1:      Value1    # comment
BField333: "Value333"    # comment

== fmt.EmptyBlocks
A: {
} B: {
} C: {} D:{}

== fmt.ListComments
# Align them too.
# Much nicer to read them.

List: [
aaa b  # comment
b ccc  # comment
1 2 3 4# comment
]

== fmt.OneListComment
# The longest line determines the spaces before the comments in a block.

List: [
VeryLongFieldName AnotherElem
Kurz # comment
AnotherVeryLongFieldName
]

== fmt.ObjectAlignment
# Align within an object too.

A: 1
Object: {
AField1: Value1 # comment
AField22: Value22    # comment
AField333: Value333    # comment

BField22: 22    # comment
BField1:      Value1    # comment
BField333: "Value333"    # comment
# full line comment
} B: 2

== fmt.RawStringAlignment
# Multiline strings also end an alignment block.

A: "hello\n"
BB: "hi"
CCC: '''|hoi
'''
DDDD: "hai"

== fmt.MultilineStringAddIndent
# Reindent multiline strings.
# The indentation change before the closing quotes must be applied to all lines.

FavoriteCode: '''go
package main

func main() {
	fmt.Println("Hello world!")
}
'''

== fmt.MultilineStringRemoveIndent
# Reindent multiline strings.
# The indentation change before the closing quotes must be applied to all lines.

FavoriteCode: '''go
		package main

		func main() {
			fmt.Println("Hello world!")
		}
		'''

== fmt.MultilineStringListAddIndent
# Reindent multiline strings.
# The indentation change before the closing quotes must be applied to all lines.

List: [
FavoriteCode '''go
package main

func main() {
	fmt.Println("Hello world!")
}
'''
]

== fmt.MultilineStringSpaceIndent
FavoriteCode: '''
  package main

  func main() {
    fmt.Println("Hello world!")
  }
  '''

== fmt.MultilineStringEmptyLines
# Remove indent for empty lines.

FavoriteCode: '''go
		package main
		
		func main() {
			fmt.Println("Hello world!")
		}
		'''

== fmt.MultilineStringNonEmptyLines
# Don't touch lines even if they have only whitespace.

FavoriteCode: '''go
		package main
			
		func main() {
			fmt.Println("Hello world!")
		}
		'''

== fmt.SimpleForms
# All forms except map() format like lists.

Dir1: A(echo.Echo 'Value1')
Dir2: B(echo.Echo
'Value2')
Dir3: C(
echo.Echo
'Value3'
)

== fmt.SaveIndentForm
Key: somedir({
  Key: Value
})

== fmt.SchemaForms
Date: struct({
  Year:  int()
  Month: identifier(checks.MatchToken('''|January|...|December''') checks.Required())
  Day:   int(
    checks.IntRange(1 31)
    checks.Required()
  )
})

== fmt.NonPairsList1
Name: List(
  v1 v2 v3
  v4 v5
  value6 value8
  v9 v10 v11)

== fmt.NonPairsList2
Name: List(
  v1 v2 v3
  v4 v5
  value6 [a b c]
  v9 v10 v11)

== fmt.NonPairsList3
Name: List(
  v1 v2 v3
  v4 v5 # Align comments.
  value6 [a b c] # Comment 2.
  v9 v10 v11)

== fmt.NonPairsList4
Name: List(
  v1 v2 v3
  v4 v5 # Align solo comments too.
  value6 [a b c]
  v9 v10 v11)

== fmt.BlockPairs
# If the first token is {, [, or a form, then consider the run as a non-aligned run.

List: [
  [1 2 3] A  # c1
  {X:Y} banana # c2
  Cherry c # c3
  F() ch # c4
]

== fmt.Forms
Name1: Form1(name1:v1 n2:v2 v3 v4 v5)
Name2: Form2(
  name1: v1
  n2:    v2
  v3 v4 v5)
Name3: Form2(
  name1: v1
  n2:v2 v3 v4 v5)

== fmt.FormNames
# Any bare token can be the name inside a form.
Name: Form(
  2006-01-02: v1
  foo-bar@baz: {v2:123}
  a.b.c+: [2]
  %: F2([{a:b}])
)

== fmt.MapIntro
# Format map() like structs.
# Keep single-line maps on a single line.

M1: map(  K1  V1   K2  V2)
M2: map(K   V
)
M3: map(
  Short Value
  LongKey Value

  K V K2 V
)

== fmt.MapNewlines
AList: [
  map( k1 v1
  k2 v2 )map(k1 v1
  k2 [v2])
]

== fmt.MapAlignment
# Align within maps too.

A: 1
Map: map(
AField1 Value1 # comment
AField22 Value22    # comment
AField333 Value333    # comment

BField22 22    # comment
BField1      Value1    # comment
BField333 "Value333"    # comment
# full line comment
) B: 2

== fmt.MapScalarFieldComment
# Fields and values are formatted to be on the same line.
# Therefore fields cannot have comments in map either,
# so move them to the key's Pre comments.
MultilineMap: map(
Field # Field comment.
Value # Value comment.

K

# Pre comment.
V K2 V

# Pre1
K3 # Post
# Pre2
V # Post
K4 V
)

== fmt.MapListFieldComment
# Fields and values are formatted to be on the same line.
# Therefore fields cannot have comments in map either,
# so move them to the key's Pre comments.
MultilineMap: map(
Field # Field comment.
[Value] # Value comment.

K

# Pre comment.
[
V
] K2 [V]

# Pre1
K3 # Post
# Pre2
[ # Pre3
V] # PostClose
K4 V
)

== fmt.RawStringMapAlignment
# Multiline strings end an alignment block.

Map: map(
A "hello\n"
BB "hi"
CCC '''|hoi
'''
DDDD "hai"

XA "hello\n"
XBB "hi"
'''|
XCCC''' "hoi"
XDDDD "hai")

== fmt.DocExample
Struct: {
  Field1: apple # comment 1
F2: banana # comment 2
A:[1 2] B:{X:Y} # comment 3
}
List: [
val1 val2 val3  # comment 1
   v1 v2 v3  # comment 2
 value1 v2    val3

col1 col2     # comment 1
  c1 c2       # comment 2
 column1 column2
]

# Avoid unnecessary indentation like in List2 here:
List1: [
form(
A:1 2
)
]
List2: [form(
A:1 2
)]

== fmt.SortValues
# Sort the children if you see a #% sdin.KeepSorted() comment.

#% sdin.KeepSorted()
UserList: [
charlie
alice
dave
frank
bob
]
 # unsorted because this node has no #sdinfmt comment.
UnsortedList: [
bob
alice
]

== fmt.SortStrings
# Sort based on the string content for string tokens.

#% sdin.KeepSorted()
UserList: [
  'charlie'
  "alice"
  "dave"
  'frank'
  '''|bob'''
]

== fmt.KeepCommentsWhenSorting
#% sdin.KeepSorted()
UserList: [
charlie
# Comment.
alice
dave  # sidecomment.
frank

bob

# Closing comment.
]

== fmt.KeepSinglelineSorted
#% sdin.KeepSorted()
Users: [charlie alice dave frank bob]

== fmt.CompareRecursively
#% sdin.KeepSorted()
Users: [
{Name:"charlie" Value:4}
{Name:"alice" Value:2}
{Name:"dave" Value:3}
{Name:"charlie" Value:1}
{Name:"frank" Value:5}
{Name:"bob" Value:6}
]

== fmt.CompareFieldsFirst
#% sdin.KeepSorted()
Usermap: {
Charlie:[cherry]
Alice:"apple"
Dave: date
Frank:{fig:1}
Bob:'''|banana'''
}

== fmt.KeepUnsorted1
#% sdin.KeepSortedNot()
UserList: [
charlie
alice
dave
frank
bob
]

== fmt.KeepUnsorted2
#% sdin.DirectivePackages()

#% notsdin.KeepSorted()
UserList: [
charlie
alice
dave
frank
bob
]

== fmt.KeepToplevelFlatlistSorted
# Remember, flat compound nodes cannot have comments attached.
# So KeepSorted can have a path argument in order to support sorting flat nodes.
#
#% sdin.KeepSorted(path: UserList)

# Make sure to keep the per-entry comments.
UserList+: charlie
UserList+: alice
UserList+: dave
UserList+: frank
UserList+: bob

== fmt.KeepInnerFlatlistSorted1
# Remember, flat compound nodes cannot have comments attached.
# So KeepSorted can have a path argument in order to support sorting flat nodes.

#% sdin.KeepSorted(path: Readers)
ACL: {
  Owners+:  olivia
  Writers+: walter

  # Make sure to keep the per entry comments, however bad the result is.
  Readers+: charlie
  Readers+: alice
  Readers+: dave
  Readers+: frank
  Readers+: bob
}

== fmt.KeepInnerFlatlistSorted2
# Remember, flat compound nodes cannot have comments attached.
# So KeepSorted can have a path argument in order to support sorting flat nodes.
#
#% sdin.KeepSorted(path: ACL.Readers)

ACL.Owners+:  olivia
ACL.Writers+: walter

# Make sure to keep the per entry comments, however bad the result is.
ACL.Readers+: charlie
ACL.Readers+: alice
ACL.Readers+: dave
ACL.Readers+: frank
ACL.Readers+: bob

== fmt.KeepSortedBadPath
#% sdin.KeepSorted(path: Foo)

== fmt.KeepSortedBadArg
#% sdin.KeepSorted(foo: bar)

== fmt.KeepSortedNoEOFNewline
#% sdin.KeepSorted(path: Users)

Users+: charlie  # C
Users+: bob      # B
Users+: alice    # A
== fmt.SdinFormatSimple
# Format `sdin` tagged strings as sdin.
Raw: '''sdin
# This is an inner sdin string.
Short: Value1
LongField: Value2
'''

== fmt.SdinFormatRaw
# Print `sdin` blocks back as multiline strings.
Raw: '''sdin|# This is an inner sdin string.
Short: Value1
LongField: Value2'''

== fmt.SdinFormatMultiline
Multiline: '''sdin
Short: Value1 # sidecomment1
LongField: Value2 # sidecomment2
List: [3   4 5 6 7] # sidecomment3
Obj: {
F1: V1 F333: V33}
'''

== fmt.SdinInSdin
F1: V1
F333: V333
F: ''''sdin
F1: V1
F333: V3
F4444: '''sdin
IF: V1
F333: V3
'''
''''

== fmt.SdinErrorInSdin
F1: OK
F2: '''sdin|
Key1: Value
Key2: # This one is missing a value.
'''

== fmt.SdinList
Field: '''sdin
ListElem1 # add support for
AnotherElem2 # list of sdin values too
Elem3

# Just parse/format this whole block as a flat form.
Name: value
AnotherName: anotherValue
'''

== fmt.AlbumExample
# This is a complete example of various ways to express a structure.

Way1: {
Album.Title: "Let It Be"
Album.Artist: "The Beatles"
Album.ReleaseDate.Year: 1970
Album.ReleaseDate.Month: "May"
Album.ReleaseDate.Day: 8
Album.Tracks+:  { Title:    "Two of Us" Duration:"3m36s" }
Album.Tracks+:  { Title:    "Dig a Pony" Duration:"3m54s" }
}

Way2: {
Album: {
Title: "Let It Be"
Artist: "The Beatles"
ReleaseDate: {Year:1970 Month:"May" Day:8}
Tracks+: { Title:"Two of Us" Duration:"3m36s" }
Tracks+: { Title:"Dig a Pony" Duration:"3m54s" }
}
}

Way3: {
Album: {
Title: "Let It Be"
Artist: "The Beatles"
ReleaseDate: {Year:1970 Month:"May" Day:8}
Tracks: [
{ Title: "Two of Us" Duration:"3m36s" }
{ Title: "Dig a Pony" Duration:"3m54s" }
]
}
}

