Key: OuterForm(Arg1 InnerForm(Arg2) Arg3)

== ast.UntaggedForm1
# All forms must have a tag name.
# Otherwise both lists below would be valid but different lists.
# The only difference is a space, and this would be surprising.
List1: [Tag()]
List2: [Tag ()]

== ast.UntaggedForm2
Name: ()

== ast.UntaggedForm3
Name: Form(())

== ast.NoTypeAnnotations
Year: (int)2006

== ast.FormNames
# Any bare token can be the name inside a form.
Name: Form(
  2006-foo/bar@baz: 123
)

== ast.DuplicateNamesInForms
# Forms allow duplicate names, go wild!
F: F(
  F(F:1 F:2)
  F(F-F:1)
)

== ast.ValuelessForm1
Name: Form(Name:)

== ast.ValuelessForm2
Name: Form(Name1: Name2:)

== ast.MatchingBlocksxf
x: f(
== ast.MatchingBlocksF
)
== ast.MatchingBlocksxF
x: )
== ast.MatchingBlocksyfOF
y: f(
})
== ast.MatchingBlocksEnvFunc
Username: stdemo.Env(USER root]
== ast.NonIdentifierName7
stdemo.Env(USER 'root') Value

== serialize.Forms
Key: Form(Struct:{InnerKey: InnerValue} [ListValue1 ListValue2])

== tojson.NonexistentForm
# Error out for unexpected forms in tojson.
Value: NonexistentForm()

== tojson.EnvIdentifierArg1
# Interpret the stdemo.Env() form as an environment variable lookup.
# Replace such a node's value with the environment's value.
Value: stdemo.Env(SDINTHROUGH_TESTVAR)

== tojson.EnvIdentifierArg2
# Interpret the stdemo.Env() form as an environment variable lookup.
Value: stdemo.Env(
  # Form arguments can have Pre comments too.
  SDINTHROUGH_TESTVAR  # And a Post comment too.
)

== tojson.EnvError
Value: stdemo.Env(SDINTHROUGH_NONEXISTENT)

== tojson.EnvDefault
Value: stdemo.Env(SDINTHROUGH_NONEXISTENT default:'default-value')

== tojson.EnvInvalidDefault1
# An envvar's type is always a string, so error out for non-string default values.
Value: stdemo.Env(SDINTHROUGH_NONEXISTENT default:123K)

== tojson.EnvInvalidDefault2
# An envvar's type is always a string, so error out for non-string default values.
Value: stdemo.Env(SDINTHROUGH_NONEXISTENT default:true)

== tojson.EnvInvalidDefault3
# An envvar's type is always a string, so error out for non-string default values.
Value: stdemo.Env(SDINTHROUGH_NONEXISTENT default:InvalidValue)

== tojson.EnvUnusedDefault
Value: stdemo.Env(SDINTHROUGH_TESTVAR default:'default-value')

== tojson.EnvInvalidInvocation1
Value: stdemo.Env(SDINTHROUGH_TESTVAR InvalidArg)

== tojson.EnvInvalidInvocation2
Value: stdemo.Env(SDINTHROUGH_TESTVAR default:'default-value' InvalidArg)

== tojson.EnvInvalidInvocation3
Value: stdemo.Env(SDINTHROUGH_TESTVAR default= 'invalid')

== tojson.EnvTooFewArgs
Value: stdemo.Env()

== tojson.EchoNumber
# Implement the stdemo.Echo(sdintxt) form.
# The sdintxt is a string argument that represents an sdin value.
# Parse that and replace the node's value with that.

Value: stdemo.Echo('1')

