== tojson.EmptyObject
# Welcome to the tojson task!
# Take your AST and emit it back as json!
# This input is empty so emit an empty json object.

== tojson.OneStringToString
# Indent the json with tabs.
# Ignore the comments.
Field1: "Value 1"

== tojson.ThreeStringsToStrings
Field1: "Value 1"
Field2: "Value 2"
Field3: "Value 3"

== tojson.InterpretLiteralsWithTabsEtc
# Interpret the strings and emit them back as quoted strings.
Field1: 'Value with a tab: 	'
Field2: 'Value with a backslash: \'
Field3: 'Value with a double quote: "'

== tojson.InterpretQuotedStringsWithTabsEtc
Field1: "Value with a tab: \t"
Field2: "Value with a tab: 	"
Field3: "Value with a backslash: \\"
Field4: "Value with a double quote: \""
Field5: "Value with a newline: \n"

== tojson.IdentifierFields
# In json the keys have to be strings.
# Convert identifier fields to strings.

Field1:           "Value 1"
Some_Other_Field: "Value 2"
true:             "Value 3"
false:            "Value 4"

== tojson.GoodIdentifierValues
# If value is `true` or `false` then keep that.
# Error out on all other identifiers.
# json doesn't have the concept of identifiers or enums.

Field1: true
Field2: false
Field3: "true"
Field4: "false"

== tojson.BadIdentifierValues1
# If value is `true` or `false` then keep that.
# Error out on all other identifiers.
# json doesn't have the concept of identifiers or enums.

Field: True

== tojson.BadIdentifierValues2
# If value is `true` or `false` then keep that.
# Error out on all other identifiers.
# json doesn't have the concept of identifiers or enums.

Field: no

== tojson.BadComment1
Field: true // Comment.

== tojson.BadComment2
Field: true /* Comment. */

== tojson.SimpleNumbers
Field1: 1
Field2: 23
Field3: -4567
Field4: +890   # numbers can't have + in json; simply remove it

== tojson.Floats
# Keep the token intact if json can parse it.

Pi:       3.14
Planck:   6.626e-34
Negative: -2.1
Positive: +2.1

== tojson.NumberBases
# Interpret hex, octal, and binary number bases while at it.
# Support 64-bit signed integers in this form.
Hex:    0xdeadBEEF
Octal:  0o644
Binary: 0b1100

== tojson.Underscores
# sdin integers can have underscores in them, ignore those.
# It's for making digit grouping easy.

Million:  1_000_000
GibiByte: 1_073_741_824
DeadBeef: 0xDEAD_beef
Planck:   6.626_e-34

== tojson.DecimalMultipliers
Kilo1: 1000
Kilo2: 1K
Mega1: 1000K
Mega2: 1M
Giga1: 1000M
Giga2: 1G
Tera1: 1000G
Tera2: 1T

== tojson.BinaryMultipliers
Kibi1: 1024
Kibi2: 1Ki
Mebi1: 1024Ki
Mebi2: 1Mi
Gibi1: 1024Mi
Gibi2: 1Gi
Tebi1: 1024Gi
Tebi2: 1Ti

== tojson.Durations
Millisecond1:  1
Second:        1s
Minute:        1m
Hour:          1h
Day:           1d
Week:          1w
NinetyMinutes: 1.5h
Millisecond2:  0.001s
Microsecond1:  0.001
Microsecond2:  1.000001s
Microsecond3:  1.234_567_800_09s

== tojson.Timestamps
# Timestamps are in UTC unless otherwise specified.
# `:` is reserved; accept underscore instead in the time part.

Date:        2006-01-02
Minute:      2006-01-02.15_04
Second:      2006-01-02.15_04_05
Millisecond: 2006-01-02.15_04_05.123
Timezone1:   2006-01-02.15_04_05.123@UTC
Timezone2:   2006-01-02.15_04@local
Timezone3:   2006-01-02.15_04@Australia/Sydney
Timezone4:   2006-01-02.15_04_00@America/New_York

