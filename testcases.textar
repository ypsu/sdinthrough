== tojson.SimplerBalancer
# You can easily add all sorts of forms in proper high-level code.
# Let's add another one: stdemo.Merge().
# It adds new fields to a struct or errors out if they already existed.
# Call it after you expanded the stdemo.Var() forms in its children.
# You can now create all sorts of DSL that your configuration needs.

#% stdemo.SkipJSONEmit()
Vars: {
  HealthCheck: {Path:'/health' Interval:30s Timeout:5s Retries:3}
  RetryPolicy: {MaxAttempts:5 Backoff:'exponential'}
  ClusterTemplate: {
    HealthCheck: stdemo.Var(HealthCheck)
    RetryPolicy: stdemo.Var(RetryPolicy)
  }
}
Title: 'High Availability redundant setup'

Clusters.Primary: stdemo.Merge(stdemo.Var(ClusterTemplate) {
  Title:     'us-east-1-prod'
  Endpoints: ['10.0.1.5:8080' '10.0.1.6:8080']
})
Clusters.Secondary: stdemo.Merge(stdemo.Var(ClusterTemplate) {
  Title:     'us-west-2-prod'
  Endpoints: ['10.0.2.5:8080' '10.0.2.6:8080']
})

== schema.EmptyFile
# Welcome to the schema task!
# The input is a schema file and you have to determine if it's valid or not.

# An empty schema file is valid.
# Just print OK for valid schema files.

