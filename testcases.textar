== ast.FlatComments
# Top Pre
# Note that flat struct and list nodes cannot have comments, only their children.
# You need to expand them to attach comments on the flat compound nodes.

# Pre 1
Object.Value: 1  # Post 1

# Pre 2
Object.List+: [  # Post 2a
	# Pre 2b
	2 # Post 2c
	# Close 2d
] # Close 2

# Pre 3
Object.List+: [3]  # Close 3

# Top Close.

== ast.FullExample
# This describes a song album.

Album.Title:       'Let It Be'
Album.Artist:      'The Beatles'
Album.ReleaseDate: {Year:1970 Month:'May' Day:8}
Album.Tracks+: {
	Title:    'Two of Us'
	Duration: "3m36s"
}
Album.Tracks+: {
	Title:    'Dig a Pony'
	Duration: "3m54s"
}
# Final comment.

