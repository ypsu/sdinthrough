)

== forms.HTMLList
stdemo.HTML(
  title('Advantages of SDINHTML')
  body(
    p("Here's how sdin HTML looks like:")
    pre('''
      stdemo.HTML(
        title('Title')
        p('Body')
      )
      ''')
    p(style:'font-weight:bold' 'Advantages:')
    ol(
      li('Closing tags get simplified to a closing paren.')
      li('Easy AST manipulation with code.')
    )
  )
)

