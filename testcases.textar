== fmt.FlatComments
# Top pretoken.

# pretoken1
Object.Value: 1 # posttoken1

# pretoken2
Object.List+:  [ # posttoken2a
	# pretoken2a
	2 # posttoken2a
	# closetoken2a
] # closetoken2

# pretoken3
Object.List+:  [3] # closetoken3

# Top closetoken.

